# SUPABASE CONFIG
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# AES-256-GCM SECRET KEY (WAJIB, 64 karakter hex / 32 bytes, jangan pakai contoh)
# Buat: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
VAULT_SECRET_KEY=

# REDIS QUEUE (BullMQ)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# DEFAULT MODEM 4G HILINK & CATCH-ALL DOMAIN
MODEM_HILINK_URL=http://192.168.8.1/api/net/reconnect
REQUIRED_RECOVERY_DOMAIN=@gudangmail.my.id
